# Copy this file to .env.local and enter the real key locally.
# Never commit .env.local or paste the key into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FREE_MODEL=deepseek-v4-flash
DEEPSEEK_PREMIUM_MODEL=deepseek-v4-pro
DEEPSEEK_AUDIT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
RATE_LIMIT_ENABLED=true

# Turnstile is optional locally. Configure both values in production to enforce bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Enables Google Geocoding for more precise city matching.
# Restrict this key to the Geocoding API and your server environment.
GOOGLE_MAPS_API_KEY=
