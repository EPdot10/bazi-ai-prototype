# Copy this file to .env.local and enter the real key locally.
# Never commit .env.local or paste the key into chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
RATE_LIMIT_ENABLED=true

# Turnstile is optional locally. Configure both values in production to enforce bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=

# Keep the question-based three-coin experiment closed in production until
# usability checks and shared Cloudflare-side abuse protection are complete.
# The NEXT_PUBLIC value is embedded at build time; the other is checked by the API.
NEXT_PUBLIC_QUESTION_BETA_ENABLED=false
QUESTION_BETA_ENABLED=false

# Optional. Enables Google Geocoding for more precise city matching.
# Restrict this key to the Geocoding API and your server environment.
GOOGLE_MAPS_API_KEY=
